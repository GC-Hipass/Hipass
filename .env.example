# 서버
APP_NAME=navercloud-ai-interview
APP_ENV=local
LOG_LEVEL=INFO

# DB (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/interview

# Ncloud 공통
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=

# Clova X (LLM)
CLOVA_X_API_URL=https://clovastudio.stream.ntruss.com
CLOVA_X_API_KEY=
CLOVA_X_MODEL=HCX-005

# Clova Voice (TTS)
CLOVA_VOICE_API_URL=https://naveropenapi.apigw.ntruss.com/tts-premium/v1/tts
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
CLOVA_VOICE_SPEAKER=nara

# Clova Speech (STT)
CLOVA_SPEECH_API_URL=
CLOVA_SPEECH_SECRET=
CLOVA_SPEECH_LANGUAGE=ko-KR

# Embedding
NCLOUD_EMBEDDING_API_URL=
NCLOUD_EMBEDDING_API_KEY=
NCLOUD_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# Object Storage (Ncloud) — 미설정 시 로컬 디스크에 저장
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
LOCAL_STORAGE_DIR=./_storage

# RAG 파라미터
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
QUESTION_COUNT=5
RECORDING_SECONDS=30
