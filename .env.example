# Server
APP_NAME=navercloud-ai-interview
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=

# DB (PostgreSQL + pgvector)
# Replace with the local tunnel URL or the internal DB URL on the app server.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/interview

# Ncloud common
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=

# LLM routing
# external: call ncloud-llm, mock: offline API wiring test
LLM_PROVIDER=external
LLM_SERVER_URL=http://127.0.0.1:8000
LLM_SERVER_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=120

# Clova Voice (TTS)
CLOVA_VOICE_API_URL=https://naveropenapi.apigw.ntruss.com/tts-premium/v1/tts
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
CLOVA_VOICE_SPEAKER=nara

# Clova Speech (STT)
STT_PROVIDER=mock
CLOVA_SPEECH_API_URL=
CLOVA_SPEECH_SECRET=
CLOVA_SPEECH_LANGUAGE=ko-KR

# Embedding
# local: run SentenceTransformer inside this FastAPI app. mock: deterministic offline vectors.
EMBEDDING_PROVIDER=local
# Reserved for a future Ncloud Embedding API provider; currently unused by the code.
NCLOUD_EMBEDDING_API_URL=
NCLOUD_EMBEDDING_API_KEY=
NCLOUD_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=384

# Object Storage (Ncloud). If empty, local filesystem storage is used.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_BUCKET_VOICE=
OBJECT_STORAGE_ACCESS_KEY_VOICE=
OBJECT_STORAGE_SECRET_KEY_VOICE=
LOCAL_STORAGE_DIR_VOICE=./_storage/audio
OBJECT_STORAGE_BUCKET_DOCUMENT=
OBJECT_STORAGE_ACCESS_KEY_DOCUMENT=
OBJECT_STORAGE_SECRET_KEY_DOCUMENT=
LOCAL_STORAGE_DIR_DOCUMENT=./_storage/documents

# RAG parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
QUESTION_COUNT=5
RECORDING_SECONDS=30
