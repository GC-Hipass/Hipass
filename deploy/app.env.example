# App server environment for hp-dev-app-srv01.
# Copy this to .env on the FastAPI app server and fill secret values there.

APP_NAME=navercloud-ai-interview
APP_ENV=prod
LOG_LEVEL=INFO
CORS_ORIGINS=http://101.79.17.102,https://hipass.duckdns.org

# Internal DB access from the app server. URL-encode the password if it has special characters.
DATABASE_URL=postgresql+psycopg://hpuser:<URL_ENCODED_DB_PASSWORD>@10.0.3.7:5432/hpdb

NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=

# App server -> LLM server over private network.
LLM_PROVIDER=external
LLM_SERVER_URL=http://10.0.4.6:8000
LLM_SERVER_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=180

# Use real Clova Speech on the server. Set STT_PROVIDER=mock only for smoke tests.
STT_PROVIDER=clova
CLOVA_SPEECH_API_URL=
CLOVA_SPEECH_SECRET=
CLOVA_SPEECH_LANGUAGE=ko-KR

CLOVA_VOICE_API_URL=https://naveropenapi.apigw.ntruss.com/tts-premium/v1/tts
CLOVA_VOICE_CLIENT_ID=
CLOVA_VOICE_CLIENT_SECRET=
CLOVA_VOICE_SPEAKER=nara

# Embeddings run inside this FastAPI app with a local 384-dim SentenceTransformer.
# If changing to a different dimension, migrate DB vector columns first.
EMBEDDING_PROVIDER=local
# Reserved for a future Ncloud Embedding API provider; currently unused by the code.
NCLOUD_EMBEDDING_API_URL=
NCLOUD_EMBEDDING_API_KEY=
NCLOUD_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=384

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_BUCKET_VOICE=
OBJECT_STORAGE_ACCESS_KEY_VOICE=
OBJECT_STORAGE_SECRET_KEY_VOICE=
LOCAL_STORAGE_DIR_VOICE=./_storage/audio
OBJECT_STORAGE_BUCKET_DOCUMENT=
OBJECT_STORAGE_ACCESS_KEY_DOCUMENT=
OBJECT_STORAGE_SECRET_KEY_DOCUMENT=
LOCAL_STORAGE_DIR_DOCUMENT=./_storage/documents

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
RERANK_TOP_K=4
QUESTION_COUNT=5
RECORDING_SECONDS=30
